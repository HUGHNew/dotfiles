{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "./"
      ],
      "allowWrite": [
        "./"
      ]
    }
  },
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(uv *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Read(./**/.env*)",
      "Edit(./**/.env*)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)",
      "Read(./.git/config)",
      "Edit(./.git/config)"
    ]
  }
}