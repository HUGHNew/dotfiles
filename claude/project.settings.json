{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "./**"
      ],
      "allowWrite": [
        "./**"
      ],
      "denyRead": [
        "./.env",
        "./.env.*",
        "./.claude/*.local.*"
      ]
    }
  },
  "permissions": {
    "ask": [
      "Bash(git push *)"
    ],
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(~/.local/bin/*)",
      "Bash(.venv/bin/python *)",
      "Bash(/opt/homebrew/bin/*)"
    ],
    "deny": [
      "Bash(python *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Read(./secrets/**)",
      "Write(./secrets/**)"
    ]
  }
}