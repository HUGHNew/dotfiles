{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "ANTHROPIC_AUTH_TOKEN": "sk-..."
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/claude.startup"
                    }
                ]
            }
        ]
    },
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline"
    },
    "permissions": {
        "allow": [
            "Bash(~/.local/bin/*)",
            "Bash(/opt/homebrew/bin/*)"
        ],
        "deny": [
            "Read(~/.ssh/**)",
            "Read(~/.gnupg/**)",
            "Bash(sudo *)",
            "Bash(rm -rf *)"
        ]
    },
    "sandbox": {
        "enabled": true,
        "filesystem": {
            "allowRead": [
                "~/.local/bin",
                "/opt/homebrew/bin"
            ],
            "denyRead": [
                "~/.ssh",
                "~/.gnupg",
                "~/.npmrc",
                "~/.pypirc",
                "~/.gitconfig",
                "~/.zsh_history",
                "~/.bash_history"
            ],
            "denyWrite": [
                "~/.ssh",
                "~/.gnupg",
                "~/.claude/settings.json"
            ]
        },
        "network": {
            "httpProxyPort": 7890,
            "socksProxyPort": 7890
        }
    }
}